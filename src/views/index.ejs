<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Blog</title>
    <link rel="stylesheet" href="/css/index.css" />
  </head>
  <body>
    <nav>
      <!-- logo -->
      <!-- <img src="" alt="" class="logo"> -->
      <span class="logo">Blogify</span>
      <div class="middle">
        <input class="search" type="text" />
        <button class="search-btn">search</button>
      </div>
      <div class="nav-right">
        <div class="nav-right-btn">
          <button class="nav-right-create">Create</button>
          <button class="nav-right-delete">Delete</button>
          <div class="changeTheme">*</div>
        </div>
        <div class="user">
          <img src="../media assets/profile.png" alt="" class="userProfie" />
        </div>
      </div>
    </nav>
    <main>
      <div class="blog">
        <div class="Blog-upper">
          <img src="" alt="" class="blog-image" />
        </div>
        <div class="Blog-lower">
          <div class="blog-title">Authentication vs authorization</div>
          <div class="Blog-description">
            Authentications and authorization are the terms used in backend
            authentication system for user login or while user accesing to the
            resources
          </div>
        </div>
      </div>
    </main>
    <footer>
      <div class="main-footer">
        <div class="main-footer-head">
          THANK YOU FOR VISITING OUR BLOG SITE !
        </div>
        <div class="main-footer-SubHead">
          Feel free to mail any suggestions in our post or anything regarding
          this website !
        </div>
        <div class="main-footer-SubHead2">
          The resources of this site are free for all and there is no copyright
          restriction.
        </div>
        <div class="mail-container">
          <textarea name="" id="" class="mail-body"></textarea>
          <button class="mail-button">Send Mail</button>
        </div>
      </div>
      <div class="side-bar"></div>
    </footer>
  </body>
</html>
