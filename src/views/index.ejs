<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Blog - ADMIN </title>
    <style>
      @import url("https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300..800;1,300..800&family=Roboto:ital,wght@0,100..900;1,100..900&display=swap");
    </style>
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&icon_names=favorite"
    />
    <link rel="stylesheet" href="/css/index.css" />
  </head>
  <body>
    <nav>
      <!-- logo -->
      <!-- <img src="" alt="" class="logo"> -->
      <span class="logo"><a href="/admin" style="color: white">Blogify</a></span>
      <div class="middle">
        <input class="search" type="text" />
        <button class="search-btn">search</button>
      </div>
      <div class="nav-right">
        <div class="nav-right-btn">
          <button class="nav-right-create">Create</button>
          <button class="nav-right-delete">Delete</button>
          <div class="changeTheme">*</div>
        </div>
        <div class="user">
          <img src="<%= user.profile %>" alt="" class="userProfie" />
        </div>
      </div>
    </nav>
    <main>
      <div class="blog-container">
        <% blogs.forEach(blog => { %>
        <div class="blog">
          <div class="blogId" style="display: none"><%= blog._id %></div>
          <img
            src="<%= blog.thumbnail %>"
            alt="Blog Image"
            class="blog-image-src"
          />
          <div class="blog-content">
            <h2 class="blog-title"><%= blog.title %></h2>
            <div class="blog-content-lower">
              <p class="blog-description"><%=blog.descriptionPlainText%>...</p>
            </div>
          </div>
        </div>
        <% }) %>
      </div>
      <div class="page-navigation">
        <button class="one nv">1</button>
        <button class="two nv">2</button>
        <button class="three nv">3</button>
        <button class="four nv">4</button>
        <button class="five nv">5</button>
      </div>
    </main>
    <footer>
      <div class="main-footer">
        <div class="main-footer-head">
          THANK YOU FOR VISITING OUR BLOG SITE !
        </div>
        <div class="main-footer-SubHead">
          Feel free to mail any suggestions in our post or anything regarding
          this website !
        </div>
        <div class="main-footer-SubHead2">
          The resources of this site are free for all and there is no copyright
          restriction.
        </div>
        <div class="mail-container">
          <textarea name="" id="" class="mail-body"></textarea>
          <button class="mail-button">Send Mail</button>
        </div>
      </div>
      <div class="side-bar"></div>
    </footer>
    <script src="/js/index.js"></script>
  </body>
</html>
